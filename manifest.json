{
  "manifest_version": 3,
  "name": "FoxLaunch",
  "version": "1.2.0",
  "description": "Container-aware New Tab workspace launchpad for Firefox Multi-Account Containers.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxlaunch@local.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": [
      "assets/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "storage",
    "tabs"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/foxlaunch-16.png",
    "48": "icons/foxlaunch-48.png",
    "128": "icons/foxlaunch-128.png"
  }
}
