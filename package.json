{
  "name": "@melkorcba/fox-launch",
  "version": "1.2.1",
  "description": "Container-aware New Tab workspace launchpad for Firefox Multi-Account Containers",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melkorCBA/fox-launch.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "web-ext-artifacts",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "lint:ext": "web-ext lint --source-dir dist",
    "package": "pnpm run build && web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest && git archive --format=zip --output=web-ext-artifacts/foxlaunch-source.zip HEAD",
    "generate:icons": "node scripts/generate-icons.mjs",
    "capture:amo": "node scripts/capture-amo-screenshots.mjs",
    "test:e2e": "playwright test",
    "test": "pnpm run typecheck && pnpm run build && pnpm run lint:ext && pnpm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0"
  },
  "pnpm": {
    "overrides": {
      "node-forge": "^1.4.2"
    }
  }
}
